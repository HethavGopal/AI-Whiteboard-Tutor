# Duplicate this file as `.env` and fill in your keys (never commit `.env`).
# PowerShell: Copy-Item .env.example .env
# cmd:         copy .env.example .env
#
# Lesson generation uses OpenAI first, then K2 Think if OpenAI is missing or fails.

# --- OpenAI (primary: outline + per-step generation) ---
OPENAI_API_KEY=
# Optional overrides (defaults match lib/k2-lesson-service.ts):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# --- K2 Think (fallback) ---
K2_THINK_API_KEY=
# Optional: use the K2-hosted API or another OpenAI-compatible base URL.
# Code default if unset: https://openrouter.ai/api/v1
K2_THINK_BASE_URL=
K2_THINK_MODEL=MBZUAI-IFM/K2-Think-v2

# --- Reserved for upcoming PRD features (not required for current lesson flow) ---
# VISION_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=
# FALLBACK_LLM_KEY=
